{
  "expo": {
    "name": "Quitify",
    "slug": "quitify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo1.png",
    "scheme": "quitify",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSMicrophoneUsageDescription": "Quitify needs microphone access so you can make voice calls.",
        "NSCameraUsageDescription": "Quitify needs camera access so you can make video calls."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1A1410",
        "foregroundImage": "./assets/images/logo-foreground.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.marwane.quitify",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo1.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Quitify to access your photos and videos to attach media to posts."
        }
      ],
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.669098937218-4aift7qa4hld3n11kplvuliq65vr97vs"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-splash.png",
          "imageWidth": 145,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4F0",
          "dark": {
            "image": "./assets/images/logo-splash.png",
            "backgroundColor": "#1A1410"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-splash.png",
          "color": "#1A1410"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Quitify needs microphone access so you can make voice calls.",
          "cameraPermission": "Quitify needs camera access so you can make video calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eeede361-3315-4679-aa70-180559080a86"
      }
    }
  }
}
